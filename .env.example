# Bind locally unless you add authentication and a trusted reverse proxy.
MORAINE_HOST=127.0.0.1
MORAINE_PORT=4781
# Optional on loopback; required when binding beyond the local machine.
MORAINE_API_TOKEN=

MORAINE_MODEL=BAAI/bge-small-zh-v1.5
MORAINE_MODEL_CACHE=./models
MORAINE_INDEX_DIR=./data
MORAINE_THREADS=2
MORAINE_BATCH_SIZE=4
MORAINE_REFRESH_SECONDS=300

# Easiest source: a JSON array, or an object containing an items, documents, or
# memories array. See examples/memories.example.json.
MORAINE_SOURCE_MODE=json
MORAINE_JSON_PATH=./examples/documents.example.json

# Standalone beta workbench. It uses its own portable JSON store and never
# reads production paths unless you explicitly import an export file.
MORAINE_BETA_HOST=127.0.0.1
MORAINE_BETA_PORT=4790
MORAINE_BETA_TOKEN=
MORAINE_BETA_DATA_FILE=./data/beta-store.json
MORAINE_BETA_SEED_FILE=./src/moraine/data/beta-seed.json
MORAINE_BETA_WEB_ROOT=./src/moraine/static

# Optional local MCP adapter. It talks to the standalone beta API and uses the
# same bearer token. Keep the beta service running while the MCP process runs.
MORAINE_MCP_URL=http://127.0.0.1:4790
MORAINE_MCP_TIMEOUT_SECONDS=10

# Optional external adviser credential for the Agent runtime. Moraine stores it
# separately from memories and exports; core recall never calls the adviser.
MORAINE_ADVISER_SECRET_FILE=./data/.adviser-secret.json

# Optional: connect the workbench search box to the local Moraine vector API.
# If it is unavailable, the workbench falls back to local keyword search.
MORAINE_SEMANTIC_URL=http://127.0.0.1:4781
MORAINE_SEMANTIC_TOKEN=

# Optional HTTP source instead of JSON. The list response may be an array or
# {"memories": [...]}. If list items do not contain full content, configure a
# detail URL with {id}. Keep source credentials outside Git.
# MORAINE_SOURCE_MODE=http
# MORAINE_HTTP_LIST_URL=http://127.0.0.1:8080/api/items?state=active&limit=1000
# MORAINE_HTTP_DETAIL_URL=http://127.0.0.1:8080/api/items/{id}
# MORAINE_HTTP_TOKEN=replace-with-source-token
